    {"name": "角色", "imm": false},
    {"name": "戰鬥", "imm": false},
    {"name": "物品", "imm": false},
    {"name": "門", "imm": false},
    {"name": "管理員", "imm": true}
  ],
  "entries": [
    {
      "category": "移動",
      "commands": ["north", "east", "south", "west", "up", "down"],
      "usage": "north east south west up down",
      "summary": "往六個方向走",
      "text": [
        "往那個方向走到隔壁的房間。",
        "門關著就過不去，要先 open。",
        "休息、睡覺時不能走，要先 stand。",
        "戰鬥中不能走，要用 flee 逃跑。"
      ]
    },
    {
      "category": "資訊",
      "commands": ["look"],
      "usage": "look [東西或方向]",
      "summary": "看房間、出口、細節",
      "text": [
        "只打 look：看你所在的房間，有誰在這裡、地上有什麼。",
        "look 方向（例如 look n）：看那個出口的樣子。",
        "look 東西：看房間裡可以細看的東西。",
        "look in 屍體：看屍體裡裝了什麼。",
        "睡著時不能用。"
      ]
    },
    {
      "category": "資訊",
      "commands": ["score"],
      "usage": "score",
      "summary": "看自己的全部屬性",
      "text": [
        "看等級、經驗、金幣、HP、MP、MV、主屬性和次要屬性。",
        "有還沒分配的點數，會寫「可分配」，用 train 分配。",
        "身上有效果時，最下面會列出來：做什麼、還有幾秒。",
        "持續加減 HP、MP、MV 的效果每 3 秒跳一次，HP 被扣到 0 會死。",
        "同一個技能再放一次是重新計時，不同技能的效果會疊在一起。"
      ]
    },
    {
      "category": "資訊",
      "commands": ["who"],
      "usage": "who",
      "summary": "看誰在線上",
      "text": [
        "列出在線上的玩家，等級高的在前面。"
      ]
    },
    {
      "category": "資訊",
      "commands": ["weather"],
      "usage": "weather",
      "summary": "看時間和天氣",
      "text": [
        "在室外才看得到：現在幾點、天空、風向。",
        "睡著時不能用。"
      ]
    },
    {
      "category": "資訊",
      "commands": ["skills"],
      "usage": "skills",
      "summary": "看你會的技能",
      "text": [
        "列出你會的技能：傷害、消耗、冷卻。冷卻中的會寫還要等幾秒。",
        "傷害是還沒被抗性擋、不含爆擊的數字。",
        "增益技能（例如餽贈）寫持續多久，下一行寫它做什麼。"
      ]
    },
    {
      "category": "資訊",
      "commands": ["help"],
      "usage": "help [分類或指令]",
      "summary": "看說明",
      "text": [
        "只打 help：看分類和每一類有哪些指令。",
        "help 分類（例如 help 戰鬥）：看這一類的指令。",
        "help 指令（例如 help kill）：看這個指令的說明。指令可以縮寫，例如 help k。"
      ]
    },
    {
      "category": "溝通",
      "commands": ["chat"],
      "usage": "chat <訊息>",
      "summary": "全服頻道",
      "text": [
        "說給所有在線上的玩家聽。",
        "睡著也能說、也聽得到。"
      ]
    },
    {
      "category": "溝通",
      "commands": ["tell"],
      "usage": "tell <名字> <訊息>",
      "summary": "密語",
      "text": [
        "只說給一個在線上的玩家聽。",
        "對方可以用 reply 回你。睡著也能說、也聽得到。"
      ]
    },
    {
      "category": "溝通",
      "commands": ["reply"],
      "usage": "reply <訊息>",
      "summary": "回覆密語",
      "text": [
        "回給最後一個 tell 你的玩家。"
      ]
    },
    {
      "category": "溝通",
      "commands": ["say"],
      "usage": "say <訊息>",
      "summary": "對同房間的人說話",
      "text": [
        "同房間醒著的人聽得到。",
        "睡著時不能說話。"
      ]
    },
    {
      "category": "角色",
      "commands": ["train"],
      "usage": "train <屬性> [點數]",
      "summary": "分配升級的點數",
      "text": [
        "每升一級得到 1 點，加在主屬性上。",
        "屬性寫 str、int、wis、con、dex，或力量、智慧、知識、體質、敏捷。",
        "點數不寫就是 1 點，例如 train str 5。每項最多 55。",
        "只打 train：看現在的主屬性和還沒分配的點數。"
      ]
    },
    {
      "category": "角色",
      "commands": ["rest"],
      "usage": "rest",
      "summary": "坐下休息",
      "text": [
        "坐著回復得比站著快。",
        "睡覺時打 rest，是醒過來坐著休息。",
        "戰鬥中不能用。"
      ]
    },
    {
      "category": "角色",
      "commands": ["sleep"],
      "usage": "sleep",
      "summary": "睡覺",
      "text": [
        "睡覺回復得最快，可是看不到、聽不到同房間的事。",
        "用 stand 或 rest 醒過來。",
        "戰鬥中不能用。"
      ]
    },
    {
      "category": "角色",
      "commands": ["stand"],
      "usage": "stand",
      "summary": "站起來",
      "text": [
        "休息、睡覺之後，要站起來才能走路、打架。",
        "戰鬥中不能用。"
      ]
    },
    {
      "category": "角色",
      "commands": ["save"],
      "usage": "save",
      "summary": "存檔",
      "text": [
        "把你的角色存起來。",
        "離開遊戲、斷線時也會自動存檔。"
      ]
    },
    {
      "category": "角色",
      "commands": ["quit"],
      "usage": "quit",
      "summary": "離開遊戲",
      "text": [
        "離開遊戲，會自動存檔。"
      ]
    },
    {
      "category": "戰鬥",
      "commands": ["kill"],
      "usage": "kill <名字>",
      "summary": "開打同房間的生物",
      "text": [
        "打同房間的生物，牠會自動還手。",
        "名字只要打開頭，例如 kill do。同名的用 2.dog 指定畫面上第 2 隻。",
        "不可以打玩家，自己也不行。",
        "休息、睡覺時不能用，要先 stand。"
      ]
    },
    {
      "category": "戰鬥",
      "commands": ["use"],
      "usage": "use <技能> [名字]",
      "summary": "放技能",
      "text": [
        "放你會的技能，例如 use fireball 3.dog：用火球打畫面上第 3 隻狗。",
        "技能名稱可以縮寫，例如 use f dog。名字只要打開頭，同名的用 2.dog。",
        "沒在打架時，打名字就跟 kill 一樣開打。",
        "打架中不打名字，是打現在的對手；打旁邊沒在打的生物，牠會加進來打你，你平砍還是打原本的對手。",
        "增益技能（例如餽贈）不打名字是給自己，打名字是給同房間的玩家，不會開打。",
        "會的技能和傷害、消耗、冷卻用 skills 看。休息、睡覺時不能用。"
      ]
    },
    {
      "category": "戰鬥",
      "commands": ["flee"],
      "usage": "flee",
      "summary": "從戰鬥中逃跑",
      "text": [
        "戰鬥中不能用走的，只能用 flee 逃跑。",
        "成功就往隨機一個開著的出口跑掉，打你的和你都停手。",
        "DEX 越高越容易成功：最低 10%，DEX 55 以上是 80%（裝備加的 DEX 也算）。",
        "失敗了要等 2 秒才能再逃。"
      ]
    },
    {
      "category": "物品",
      "commands": ["get"],
      "usage": "get <東西> [容器]",
      "summary": "撿東西、從屍體拿東西",
      "text": [
        "get 東西：撿地上的。get all：撿地上全部撿得起來的。",
        "get 東西 屍體：從屍體裡拿。get all 屍體：裡面的全部拿出來。屍體本身撿不起來。",
        "名字只要打開頭，同名的用 2.sword。",
        "背包最多 35 件，重量不能超過負重（看力量），用 inventory 看。睡著時不能用。"
      ]
    },
    {
      "category": "物品",
      "commands": ["drop"],
      "usage": "drop <東西>",
      "summary": "丟到地上",
      "text": [
        "把背包裡的東西丟到地上。drop all：全部丟掉。",
        "丟在地上的東西不會自己消失，但是區域重新建立時會不見。睡著時不能用。"
      ]
    },
    {
      "category": "物品",
      "commands": ["wear"],
      "usage": "wear <東西>",
      "summary": "穿上裝備",
      "text": [
        "穿上背包裡的裝備，那個部位有東西就先換下來。wear all：能穿的都穿到空的部位。",
        "等級不夠的裝備不能穿；武器太重（看力量）不能拿。",
        "雙手武器同時佔主手和副手。副手拿武器（雙持）要先拿主手的武器。",
        "穿上的裝備會加屬性，用 score 看。打架中也可以換。睡著時不能用。"
      ]
    },
    {
      "category": "物品",
      "commands": ["remove"],
      "usage": "remove <東西>",
      "summary": "卸下裝備",
      "text": [
        "把穿著的裝備卸下來放回背包。remove all：全部卸下來。",
        "雙持時要先卸下左手的武器。背包滿了卸不下來。睡著時不能用。"
      ]
    },
    {
      "category": "物品",
      "commands": ["inventory"],
      "usage": "inventory",
      "summary": "看背包",
      "text": [
        "看背包裡有什麼，最後一行是件數和負重（身上穿的也算重量）。"
      ]
    },
    {
      "category": "物品",
      "commands": ["equipment"],
      "usage": "equipment",
      "summary": "看身上的裝備",
      "text": [
        "看身上每個部位穿了什麼。"
      ]
    },
    {
      "category": "物品",
      "commands": ["examine"],
      "usage": "examine <東西>",
      "summary": "看物品的屬性",
      "text": [
        "看背包裡或身上穿的物品：種類、重量、使用等級、稀有度、穿在哪裡。",
        "武器看得到攻擊力範圍，護具看得到防護力，也看得到加了哪些屬性。",
        "地上的東西要先撿起來才能看。睡著時不能用。"
      ]
    },
    {
      "category": "門",
      "commands": ["open"],
      "usage": "open <門、方向或容器>",
      "summary": "開門、打開容器",
      "text": [
        "打開關著的門或容器（箱子、袋子）。可以寫門的名字、方向（例如 open n），或容器的名字。",
        "先找門的名字，再找方向，最後才找東西，所以 open n 一定是北邊的門。",
        "鎖著的要先 unlock。對面房間的人會看到門打開。睡著時不能用。"
      ]
    },
    {
      "category": "門",
      "commands": ["close"],
      "usage": "close <門、方向或容器>",
      "summary": "關門、關上容器",
      "text": [
        "關上開著的門或容器。找的順序跟 open 一樣。",
        "對面房間的人會看到門關上。關著的容器拿不出東西。睡著時不能用。"
      ]
    },
    {
      "category": "門",
      "commands": ["lock"],
      "usage": "lock <門、方向或容器>",
      "summary": "上鎖",
      "text": [
        "把關著的門或容器鎖起來，要有它的鑰匙（背包裡或身上都算）。",
        "有些門、容器沒辦法上鎖。睡著時不能用。"
      ]
    },
    {
      "category": "門",
      "commands": ["unlock"],
      "usage": "unlock <門、方向或容器>",
      "summary": "開鎖",
      "text": [
        "打開門或容器的鎖，要有它的鑰匙（背包裡或身上都算）。",
        "開了鎖還要 open 才會打開。睡著時不能用。"
      ]
    },
    {
      "category": "管理員",
      "commands": ["advance"],
      "usage": "advance <名字> <等級>",
      "summary": "改玩家的等級",
      "text": [
        "把在線上的玩家升到（或降到）那個等級，1 到 100。",
        "這一級的經驗值歸 0。"
      ]
    },
    {
      "category": "管理員",
      "commands": ["slay"],
      "usage": "slay <名字>",
      "summary": "直接殺死生物",
      "text": [
        "直接殺死同房間的生物，原地留下屍體，不給經驗。",
        "名字只要打開頭，同名的用 2.dog。不能殺玩家。"
      ]
    },
    {
      "category": "管理員",
      "commands": ["oload"],
      "usage": "oload <號碼> [等級] [顏色]",
      "summary": "做出一件物品",
      "text": [
        "照區域檔做一件物品，號碼是遊戲號碼（例如 oload 102 1 white：1 級白色的測試長劍）。",
        "等級沒寫是你的等級；顏色寫 gray、white、blue、purple、orange，沒寫就沒有隨機屬性。",
        "撿得起來的放進你的背包，撿不起來的放在地上。不管負重、件數。"
      ]
    },
    {
      "category": "管理員",
      "commands": ["ostat"],
      "usage": "ostat <名字或號碼>",
      "summary": "看物品的全部資料",
      "text": [
        "ostat 名字：找你的背包、身上、地上、地上屍體裡的物品，列出全部資料（點數、上限、基本值的小數）。",
        "ostat 號碼：看區域檔裡那件物品原本的寫法。"
      ]
    },
    {
      "category": "管理員",
      "commands": ["mstat"],
      "usage": "mstat <名字>",
      "summary": "看生物或玩家的全部資料",
      "text": [
        "看同房間的生物或玩家：等級、種類、全部屬性（小數）、掉落表；玩家還有主屬性、經驗、背包和裝備件數。",
        "名字的找法跟 kill 一樣。"
      ]
    },
    {
      "category": "管理員",
      "commands": ["restore"],
      "usage": "restore <名字或 all>",
      "summary": "補滿 HP、MP、MV",
      "text": [
        "把那個人的 HP、MP、MV 補滿，技能的冷卻也清掉。restore all：所有在線的玩家。",
        "名字先找同房間的（生物也可以，名字的找法跟 kill 一樣），找不到再找線上的玩家。"
      ]
    },
    {
      "category": "管理員",
      "commands": ["affect"],
      "usage": "affect <名字> <poison、regen、bless、blind、clear>",
      "summary": "放測試用的效果",
      "text": [
        "給那個人放一個測試用的效果（數字只是測試用）：",
        "poison 每 3 秒 HP -10、regen 每 3 秒 HP +10、",
        "bless 命中 +10（死掉後還在）、blind 失明。",
        "clear 清掉他身上全部的效果。名字的找法跟 restore 一樣。"
      ]
    },
    {
      "category": "管理員",
      "commands": ["sset"],
      "usage": "sset <名字> <技能> [off]",
      "summary": "讓玩家學會、忘掉技能",
      "text": [
        "讓線上的玩家學會一個技能，加 off 是忘掉。",
        "名字只要打開頭；技能名稱可以縮寫，例如 sset ming fire。",
        "只有 imm 會的技能（天雷）不能給別人。"
      ]
    }
  ]
}
